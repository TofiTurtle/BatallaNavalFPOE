<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.batallanavalfpoe.controller.GameController">
   <children>
      <ImageView fitHeight="809.0" fitWidth="1200.0" preserveRatio="false">
         <image>
            <Image url="@images/background.gif" />
         </image>
      </ImageView>
      <VBox alignment="CENTER" prefHeight="785.0" prefWidth="1200.0">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="186.0" prefWidth="266.0">
                     <children>
                        <ImageView fx:id="img" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                        <Label fx:id="nameLabel" textAlignment="CENTER" textFill="WHITE">
                           <font>
                              <Font name="Star Jedi Logo MonoLine" size="25.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets right="320.0" />
                     </HBox.margin>
                  </VBox>
                  <Label text="Posiciona tus flotas" textAlignment="RIGHT" textFill="WHITE">
                     <font>
                        <Font name="Star Jedi Logo MonoLine" size="40.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <HBox fx:id="gridsHBox" alignment="CENTER" prefHeight="470.0" spacing="60.0">
               <children>
                  <StackPane prefHeight="470.0" prefWidth="200.0">
                     <VBox fx:id="fleetVBox" alignment="CENTER" spacing="5.0">
                        <Label text="flotas disponibles" textFill="WHITE">
                           <font>
                              <Font name="Star Jedi Logo MonoLine" size="17.0" />
                           </font>
                        </Label>
                        <Rectangle fx:id="carrier" arcHeight="10" arcWidth="10" fill="#6A5ACD" height="40.0" stroke="black" width="160.0" />
                        <Rectangle fx:id="submarine1" arcHeight="10" arcWidth="10" fill="#20B2AA" height="40.0" stroke="black" width="120.0" />
                        <Rectangle fx:id="submarine2" arcHeight="10" arcWidth="10" fill="#20B2AA" height="40.0" stroke="black" width="120.0" />
                        <Rectangle fx:id="destroyer1" arcHeight="10" arcWidth="10" fill="#FFA500" height="40.0" stroke="black" width="80.0" />
                        <Rectangle fx:id="destroyer2" arcHeight="10" arcWidth="10" fill="#FFA500" height="40.0" stroke="black" width="80.0" />
                        <Rectangle fx:id="destroyer3" arcHeight="10" arcWidth="10" fill="#FFA500" height="40.0" stroke="black" width="80.0" />
                        <Rectangle fx:id="frigate1" arcHeight="10" arcWidth="10" fill="#DC143C" height="40.0" stroke="black" width="40.0" />
                        <Rectangle fx:id="frigate2" arcHeight="10" arcWidth="10" fill="#DC143C" height="40.0" stroke="black" width="40.0" />
                        <Rectangle fx:id="frigate3" arcHeight="10" arcWidth="10" fill="#DC143C" height="40.0" stroke="black" width="40.0" />
                        <Rectangle fx:id="frigate4" arcHeight="10" arcWidth="10" fill="#DC143C" height="40.0" stroke="black" width="40.0" />
                     </VBox>
                  </StackPane>

                  <VBox alignment="CENTER" spacing="10">
                     <Label text="jugador" textFill="WHITE">
                        <font>
                           <Font name="Star Jedi Logo MonoLine" size="18.0" />
                        </font>
                     </Label>
                     <StackPane fx:id="playerGridContainer" prefHeight="400.0">
                        <cursor>
                           <Cursor fx:constant="HAND" />
                        </cursor>
                     </StackPane>
                  </VBox>

                  <VBox alignment="CENTER" spacing="10">
                     <Label text="oponente" textFill="WHITE">
                        <font>
                           <Font name="Star Jedi Logo MonoLine" size="18.0" />
                        </font>
                     </Label>
                     <StackPane fx:id="mainGridContainer" prefHeight="400.0">
                        <cursor>
                           <Cursor fx:constant="HAND" />
                        </cursor>
                     </StackPane>
                  </VBox>
               </children>
            </HBox>

            <HBox fx:id="buttonsHBox" alignment="CENTER" prefHeight="100.0" spacing="50.0">
               <children>
                  <Button fx:id="leaveButton" onAction="#goToWelcomeStage" prefHeight="78.0" prefWidth="373.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 10; -fx-border-width: 1.5px;" text="Abandonar juego" textFill="WHITE">
                     <font>
                        <Font name="Star Jedi Logo MonoLine" size="24.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <effect>
                        <Glow level="1.0" />
                     </effect>
                  </Button>

                  <Button fx:id="playButton" onAction="#handlePlayButton" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 10; -fx-border-width: 1.5px;" text="Jugar" textFill="WHITE">
                     <font>
                        <Font name="Star Jedi Logo MonoLine" size="24.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <effect>
                        <Glow level="1.0" />
                     </effect>
                  </Button>

                  <Button fx:id="opponentButton" onAction="#showOpponentBoard" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 10; -fx-border-width: 1.5px;" text="ver posición del oponente" textFill="WHITE">
                     <font>
                        <Font name="Star Jedi Logo MonoLine" size="24.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <effect>
                        <Glow level="1.0" />
                     </effect>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
